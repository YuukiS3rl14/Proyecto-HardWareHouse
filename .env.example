# Copia este archivo como .env y reemplaza los valores.
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='cambia-esta-clave'

# True en desarrollo, False en AWS.
DEBUG=False

# Pon False si en AWS todavía no tienes HTTPS configurado.
USE_HTTPS=True

# Local: variables DB_*. En Railway (u otro PaaS), define DATABASE_URL y omite DB_*.
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_bd

DB_NAME=bd_hardwarehouse
DB_USER=postgres
DB_PASSWORD='cambia-esta-contraseña'
DB_HOST=127.0.0.1
DB_PORT=5432

# URL pública del sitio, sin '/' final. PayPal debe poder llamar a https://url-ejemplo/paypal/
# En Railway suele coincidir con https://${RAILWAY_PUBLIC_DOMAIN} (Railway la define en el servicio web).
SITE_URL=https://url-ejemplo

# Railway inyecta RAILWAY_PUBLIC_DOMAIN (ej. mi-app-production.up.railway.app); no hace falta en .env local.

# Cloudflare R2 (media + estáticos). En local deja USE_R2=False (WhiteNoise + disco).
# USE_R2=True
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=cdn.tudominio.com

# Sandbox: True. Con la cuenta real de PayPal, en producción, pon False.
PAYPAL_TEST=True
# Correo de la cuenta Business del Sandbox (developer.paypal.com → Sandbox → Accounts).
# Crea también una cuenta Personal: sirve para pagar en sandbox.paypal.com, no se configura aquí.
PAYPAL_RECEIVER_EMAIL=sb-tu-cuenta-business@business.example.com

# Chatbot: Ollama local (opcional). Sin URL = motor de reglas + ORM.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b-instruct
# OLLAMA_TIMEOUT=25
# HARDWAREHOUSE_CHAT_INTENT_LLM=True
# HARDWAREHOUSE_CHAT_RESPONSE_LLM=True
