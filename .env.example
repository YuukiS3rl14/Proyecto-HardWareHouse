# Copia este archivo como .env y reemplaza los valores.
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='cambia-esta-clave'

# True en desarrollo, False en AWS.
DEBUG=False

# Pon False si en AWS todavía no tienes HTTPS configurado.
USE_HTTPS=True

# Local: variables DB_*. En Railway (u otro PaaS), define DATABASE_URL y omite DB_*.
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_bd

DB_NAME=bd_hardwarehouse
DB_USER=postgres
DB_PASSWORD='cambia-esta-contraseña'
DB_HOST=127.0.0.1
DB_PORT=5432

# URL pública del sitio, sin '/' final. PayPal debe poder llamar a https://url-ejemplo/paypal/
# En Railway suele coincidir con https://${RAILWAY_PUBLIC_DOMAIN} (Railway la define en el servicio web).
SITE_URL=https://url-ejemplo

# Railway inyecta RAILWAY_PUBLIC_DOMAIN (ej. mi-app-production.up.railway.app); no hace falta en .env local.

# Cloudflare R2 (media + estáticos). En local deja USE_R2=False (WhiteNoise + disco).
# USE_R2=True
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=cdn.tudominio.com

# Sandbox: True. Con la cuenta real de PayPal, en producción, pon False.
PAYPAL_TEST=True
# Correo de la cuenta Business del Sandbox (developer.paypal.com → Sandbox → Accounts).
# Crea también una cuenta Personal: sirve para pagar en sandbox.paypal.com, no se configura aquí.
PAYPAL_RECEIVER_EMAIL=sb-tu-cuenta-business@business.example.com

# Correo público del formulario y del pie. No es un secreto.
# EmailJS debe entregar a esta dirección. Django acepta CONTACT_EMAIL o CONTACTO_EMAIL.
CONTACT_EMAIL=contacto@hardwarehouse.cl

# Destinos del Worker de Cloudflare. Django no los usa.
# También hay que verificarlos en Email Routing y publicarlos con el Worker.
WORKER_EMAIL=trabajadorhardwarehouse@gmail.com
ADMIN_EMAIL=administradorhardwarehouse@gmail.com

# EmailJS. Las claves se leen solo en el servidor. No las pongas en JavaScript ni en Git.
# Los identificadores de servicio y plantilla no son secretos; la clave privada sí.
EMAILJS_SERVICE_ID=service_jrqdng2
EMAILJS_TEMPLATE_CONTACTO=template_aldusli
EMAILJS_TEMPLATE_PEDIDO=template_fh7t9jw
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# EMAILJS_TIMEOUT=10
# EMAILJS_RECLAMO_SEGUNDOS=120
# CONTACTO_CORREO_LIMITE=5
# CONTACTO_CORREO_VENTANA=600

# Django no envía correo por SMTP. No definas EMAIL_HOST.
# El reenvío a trabajadorhardwarehouse@gmail.com y administradorhardwarehouse@gmail.com
# vive en cloudflare/email-worker/, que no se despliega con Railway.

# Chatbot. Sin URL = motor de reglas + ORM, sin red.
# Local, sin clave:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b-instruct
# Nube, cuando exista una cuenta: URL https, clave y un modelo que ese host publique.
# qwen3:4b-instruct es una etiqueta local; no la uses en la nube si el catálogo remoto no la ofrece.
# OLLAMA_BASE_URL=
# OLLAMA_API_KEY=
# OLLAMA_MODEL=
# OLLAMA_TIMEOUT=10
# HARDWAREHOUSE_CHAT_INTENT_LLM=True
# HARDWAREHOUSE_CHAT_RESPONSE_LLM=False
