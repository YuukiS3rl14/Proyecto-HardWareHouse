# Copia este archivo como .env y reemplaza los valores.
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='cambia-esta-clave'

# True en desarrollo, False en AWS.
DEBUG=False

# Pon False si en AWS todavía no tienes HTTPS configurado.
USE_HTTPS=True

DB_NAME=bd_hardwarehouse
DB_USER=postgres
DB_PASSWORD='cambia-esta-contraseña'
DB_HOST=127.0.0.1
DB_PORT=5432

# URL pública del sitio, sin '/' final. PayPal debe poder llamar a https://url-ejemplo/paypal/
SITE_URL=https://url-ejemplo

# Sandbox: True. Con la cuenta real de PayPal, en producción, pon False.
PAYPAL_TEST=True
# Correo de la cuenta Business del Sandbox (developer.paypal.com → Sandbox → Accounts).
# Crea también una cuenta Personal: sirve para pagar en sandbox.paypal.com, no se configura aquí.
PAYPAL_RECEIVER_EMAIL=sb-tu-cuenta-business@business.example.com
